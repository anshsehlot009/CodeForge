# ─────────────────────────────────────────────────────────────────────────────
# Convoy environment — copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets. Keep this example in sync.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / inference providers (packages/core) ──────────────────────────────
GROQ_API_KEY=              # strong default LLM (review / suggest / edit)
GROQ_MODEL=                # optional; default llama-3.3-70b-versatile

FAST_PROVIDER=cerebras     # which fast LLM to use: "cerebras" or "gemini"
CEREBRAS_API_KEY=          # fast LLM (option A) — hover / triage
CEREBRAS_MODEL=            # optional; default llama-3.3-70b
GEMINI_API_KEY=            # fast LLM (option B)
GEMINI_MODEL=              # optional; default gemini-2.0-flash

# Embeddings run locally via `fastembed` — no API key required.
EMBED_MODEL=bge-small      # "bge-small" (384-dim) or "bge-base" (768-dim)
FASTEMBED_CACHE_DIR=       # optional; where to cache downloaded model weights

# ── Supabase: vector store + data (packages/db) ────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # SERVER ONLY — keep real values in .env.local
DATABASE_URL=your_postgres_connection_string
SUPABASE_EMBEDDINGS_TABLE= 
SUPABASE_MATCH_FN=
# ── Web app (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── GitHub App (apps/github) ───────────────────────────────────────────────
APP_ID=
PRIVATE_KEY=               # PEM contents (escape newlines) or a path to the .pem
WEBHOOK_SECRET=            # HMAC secret; Probot verifies X-Hub-Signature-256
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PORT=3000

# ── Ingest queue (apps/github) ─────────────────────────────────────────────
REDIS_URL=                 # Upstash/Redis TCP URL for BullMQ; if empty, ingest runs inline
